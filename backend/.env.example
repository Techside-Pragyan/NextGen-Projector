# Application Configuration
PROJECT_NAME="NextGen-Projector API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# PostgreSQL Database (Change credentials as needed)
# For local dev without Postgres running, backend falls back gracefully to SQLite async (sqlite+aiosqlite:///./nextgen.db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nextgen_projector
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nextgen_projector"

# Redis Cache (Optional, in-memory fallback enabled)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
SECRET_KEY="nextgen_super_secret_jwt_key_replace_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI API Key
GEMINI_API_KEY=""
AI_PRIMARY_MODEL="gemini-1.5-pro-latest"
AI_FAST_MODEL="gemini-1.5-flash-latest"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
